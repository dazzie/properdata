# =============================================================================
# ProperData — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values you need.
# Phase 1 minimum: DATABASE_URL + ANTHROPIC_API_KEY + CRON_SECRET

# -----------------------------------------------------------------------------
# Core (required for any local development)
# -----------------------------------------------------------------------------

# Neon Postgres connection string
# Get from: https://console.neon.tech (create project, enable PostGIS + pgvector)
DATABASE_URL=postgres://user:password@ep-xxx.eu-west-2.aws.neon.tech/properdata?sslmode=require

# Direct connection for migrations (Neon provides this in console)
DIRECT_DATABASE_URL=postgres://user:password@ep-xxx.eu-west-2.aws.neon.tech/properdata?sslmode=require

# Anthropic API key
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Random string used to authorize cron job invocations
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Node environment
NODE_ENV=development

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking
# Get from: https://sentry.io (free tier sufficient for Phase 1)
SENTRY_DSN=

# Slack webhook for pipeline failure alerts and weekly draft notifications
SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Cache and rate limiting (Phase 1: optional, Phase 2+: required)
# -----------------------------------------------------------------------------

# Upstash Redis for caching town metrics and rate limiting
# Get from: https://upstash.com (free tier sufficient for Phase 1)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Object storage (PDFs, charts, exports)
# -----------------------------------------------------------------------------

# Cloudflare R2 (S3-compatible, zero egress fees)
# Get from: https://dash.cloudflare.com → R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=properdata-assets
R2_PUBLIC_URL=https://assets.properdata.ie

# -----------------------------------------------------------------------------
# Auth and billing (Phase 3)
# -----------------------------------------------------------------------------

# Clerk authentication
# Get from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe billing
# Get from: https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# B2B API key management — master key for CRUD operations on API keys
# Generate with: openssl rand -hex 32
API_MASTER_KEY=

# -----------------------------------------------------------------------------
# Email (Phase 3: transactional and alert emails)
# -----------------------------------------------------------------------------

# Resend
# Get from: https://resend.com
RESEND_API_KEY=
RESEND_FROM_ADDRESS=hello@properdata.ie

# -----------------------------------------------------------------------------
# Scraping (ePlanning portals only — public data)
# -----------------------------------------------------------------------------

# Browserless.io for headless Chrome
# Get from: https://browserless.io
BROWSERLESS_TOKEN=
BROWSERLESS_URL=https://chrome.browserless.io

# -----------------------------------------------------------------------------
# Geocoding and addressing
# -----------------------------------------------------------------------------

# GeoDirectory licence (Phase 2+, ~€2-5K/year)
GEODIRECTORY_API_KEY=

# Autoaddress / Eircode lookup (Phase 2+)
AUTOADDRESS_API_KEY=

# -----------------------------------------------------------------------------
# Analytics (Phase 3)
# -----------------------------------------------------------------------------

# PostHog product analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# -----------------------------------------------------------------------------
# Substack (Phase 1-2 — newsletter delivery)
# -----------------------------------------------------------------------------

# Substack doesn't have a public API for posting, but useful for tracking
SUBSTACK_PUBLICATION_URL=https://properdata.substack.com

# -----------------------------------------------------------------------------
# Maps (Phase 3 — town explorer)
# -----------------------------------------------------------------------------

# Mapbox public token
NEXT_PUBLIC_MAPBOX_TOKEN=
