{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm turbo run build --filter=@properdata/web",
  "outputDirectory": "apps/web/.next",
  "crons": [
    { "path": "/api/cron/ppr-ingest", "schedule": "0 2 * * 0" },
    { "path": "/api/cron/ber-refresh", "schedule": "0 3 1 * *" },
    { "path": "/api/cron/eplanning-scrape", "schedule": "0 8 * * 1" },
    { "path": "/api/cron/cso-refresh", "schedule": "0 4 15 * *" },
    { "path": "/api/cron/metrics-refresh", "schedule": "0 6 * * *" },
    { "path": "/api/cron/regulatory-scan", "schedule": "0 7 * * *" },
    { "path": "/api/cron/weekly-pulse", "schedule": "0 14 * * 0" },
    { "path": "/api/cron/anomaly-detect", "schedule": "0 6 * * 1" }
  ]
}
